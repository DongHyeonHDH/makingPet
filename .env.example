# 복사해서 사용: cp .env.example .env   (.env 는 git 에 올리지 않는다)
# docker compose 와 Spring Boot(IntelliJ 실행 구성의 env 파일)가 같은 파일을 쓴다.

# ===== PostgreSQL (docker compose) =====
POSTGRES_DB=makingpet
POSTGRES_USER=makingpet
POSTGRES_PASSWORD=makingpet_local_pw
POSTGRES_PORT=5432

# ===== Spring Boot DB 연결 (application.yaml 의 DB_*) =====
DB_URL=jdbc:postgresql://localhost:5432/makingpet
DB_USERNAME=makingpet
DB_PASSWORD=makingpet_local_pw
DDL_AUTO=validate
FLYWAY_ENABLED=true
H2_CONSOLE=false

# ===== Redis (compose + Spring 공용) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=makingpet_redis_pw
CACHE_TYPE=redis

# ===== 기타 (선택) =====
# MAKINGPET_JWT_SECRET=          # Base64 32바이트 이상. 비우면 기동마다 랜덤
# MAKINGPET_ADMIN_PASSWORD=      # 설정하면 관리자 계정 시드 생성
